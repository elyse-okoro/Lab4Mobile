<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.lab4mobile.ui.home.HomeFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_placeDetail"
            app:destination="@id/placeDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/categoriesFragment"
        android:name="com.example.lab4mobile.ui.categories.CategoriesFragment"
        android:label="@string/nav_categories"
        tools:layout="@layout/fragment_list">
        <action
            android:id="@+id/action_categories_to_places"
            app:destination="@id/placesFragment" />
    </fragment>

    <fragment
        android:id="@+id/favoritesFragment"
        android:name="com.example.lab4mobile.ui.favorites.FavoritesFragment"
        android:label="@string/nav_favorites"
        tools:layout="@layout/fragment_list">
        <action
            android:id="@+id/action_favorites_to_placeDetail"
            app:destination="@id/placeDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/placesFragment"
        android:name="com.example.lab4mobile.ui.places.PlacesFragment"
        android:label="{categoryTitle}"
        tools:layout="@layout/fragment_list">
        <argument
            android:name="categoryId"
            app:argType="com.example.lab4mobile.data.model.CategoryId" />
        <argument
            android:name="categoryTitle"
            app:argType="string" />
        <action
            android:id="@+id/action_places_to_placeDetail"
            app:destination="@id/placeDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/placeDetailFragment"
        android:name="com.example.lab4mobile.ui.detail.PlaceDetailFragment"
        android:label="{placeName}"
        tools:layout="@layout/fragment_place_detail">
        <argument
            android:name="placeId"
            app:argType="string" />
        <argument
            android:name="placeName"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/aboutFragment"
        android:name="com.example.lab4mobile.ui.about.AboutFragment"
        android:label="@string/nav_about"
        tools:layout="@layout/fragment_about" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.lab4mobile.ui.settings.SettingsFragment"
        android:label="@string/nav_settings"
        tools:layout="@layout/fragment_settings" />
</navigation>
